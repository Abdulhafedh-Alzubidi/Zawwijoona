rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // قواعد المستخدمين: كل مستخدم مسجل دخول يمكنه قراءة وكتابة بياناته فقط
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // السماح بالقراءة والكتابة لأي مستند إضافي للمستخدمين المسجلين
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
